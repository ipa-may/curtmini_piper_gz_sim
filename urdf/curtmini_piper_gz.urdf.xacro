<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="curtmini_piper">
  <!-- The physical robot and sensor frames remain owned by the description package. -->
  <xacro:include filename="$(find curtmini_piper_description)/urdf/curtmini_piper.urdf.xacro" />
  <xacro:arg name="use_cameras" default="True" />

  <xacro:macro name="sim_d435i" params="name">
    <!-- Preserve the body link so Gazebo can attach rendering and IMU sensors. -->
    <gazebo reference="${name}_body_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="${name}_body_link">
      <sensor name="${name}_rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/${name}</topic>
        <gz_frame_id>${name}_color_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
      </sensor>
      <sensor name="${name}_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <pose>0 0 0 -1.5707963267948966 0 -1.5707963267948966</pose>
        <topic>/${name}/imu</topic>
        <gz_frame_id>${name}_imu_optical_frame</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="$(arg use_cameras)">
    <xacro:sim_d435i name="base_camera" />
    <xacro:sim_d435i name="tool_camera" />
  </xacro:if>

  <!-- Keep the fixed sensor link in the generated SDF instead of lumping it. -->
  <xacro:if value="$(arg use_hokuyo)">
    <gazebo reference="hokuyo_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="hokuyo_link">
      <sensor name="hokuyo_utm_30lx_ew" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>40</update_rate>
        <visualize>true</visualize>
        <topic>/scan</topic>
        <gz_frame_id>hokuyo_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1081</samples>
              <resolution>1</resolution>
              <min_angle>-2.356194490192345</min_angle>
              <max_angle>2.356194490192345</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- Ground-truth pose from the physics engine, for odometry validation only. -->
  <!-- Its TF goes to an unbridged topic so it cannot clash with odom->base_link. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <tf_topic>/ground_truth/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

  <!-- Wheel contact model (simulation only). Overrides curt_mini's wheel_ode_params:
       isotropic friction, primary friction direction along the wheel axle (as WheelSlip
       expects), and linear tyre slip compliance. See doc/odometry_calibration.md. -->
  <xacro:property name="wheel_slip_lateral" value="1.0" />
  <xacro:property name="wheel_slip_longitudinal" value="0.05" />

  <xacro:macro name="sim_wheel_friction" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <!-- fdir1 is in the collision frame; the wheel cylinder is rotated rpy="pi/2 0 0",
           so its local z is the wheel axle. -->
      <fdir1>0 0 1</fdir1>
    </gazebo>
  </xacro:macro>
  <xacro:sim_wheel_friction link="front_left_wheel" />
  <xacro:sim_wheel_friction link="front_right_wheel" />
  <xacro:sim_wheel_friction link="back_left_wheel" />
  <xacro:sim_wheel_friction link="back_right_wheel" />

  <!-- Normal forces: static loads with the arm at its initial pose (16.5 kg, CoM x=+0.068 m). -->
  <xacro:macro name="sim_wheel_slip" params="link normal_force">
    <wheel link_name="${link}">
      <wheel_radius>0.13</wheel_radius>
      <wheel_normal_force>${normal_force}</wheel_normal_force>
      <slip_compliance_lateral>${wheel_slip_lateral}</slip_compliance_lateral>
      <slip_compliance_longitudinal>${wheel_slip_longitudinal}</slip_compliance_longitudinal>
    </wheel>
  </xacro:macro>
  <gazebo>
    <plugin filename="gz-sim-wheel-slip-system" name="gz::sim::systems::WheelSlip">
      <xacro:sim_wheel_slip link="front_left_wheel" normal_force="51.6" />
      <xacro:sim_wheel_slip link="front_right_wheel" normal_force="50.7" />
      <xacro:sim_wheel_slip link="back_left_wheel" normal_force="30.3" />
      <xacro:sim_wheel_slip link="back_right_wheel" normal_force="29.7" />
    </plugin>
  </gazebo>
</robot>
