<?xml version="1.0"?>
<sdf version="1.9">
  <world name="curtmini_piper_map">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"
    />
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"
    />
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"
    />
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"
    />
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors"
    >
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.45 0.48 1</ambient>
            <diffuse>0.52 0.55 0.58 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Reuse the Neo office model composition while keeping physics and
         rendering configuration in this simulation package. These poses are
         the arrangement defined by neo_gz_worlds/office_harmonic_02.sdf. -->
    <include>
      <uri>model://office_env</uri>
      <name>office_env</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://office_env_w</uri>
      <name>office_env_w</name>
      <pose>0 4.95791 1.25 0 0 0</pose>
    </include>
    <include>
      <uri>model://office_env_w1</uri>
      <name>office_env_w1</name>
      <pose>5.73367 0.847832 1.25 0 0 1.57</pose>
    </include>
    <include>
      <uri>model://office_env_w2</uri>
      <name>office_env_w2</name>
      <pose>-3.62252 -4.162 1.25 0 0 0</pose>
    </include>
    <include>
      <uri>model://office_chair_red</uri>
      <name>office_chair_red</name>
      <pose>-2.61364 -5.08383 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://office_chair_green</uri>
      <name>office_chair_green</name>
      <pose>-4.31515 -3.1294 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>model://couch</uri>
      <name>couch</name>
      <pose>-1.10651 -9.2964 0 0 0 1.58036</pose>
    </include>
    <include>
      <uri>model://office_desk</uri>
      <name>office_desk</name>
      <pose>-2.32929 -3.61355 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://yellow_bin</uri>
      <name>yellow_bin</name>
      <pose>-2.32929 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
