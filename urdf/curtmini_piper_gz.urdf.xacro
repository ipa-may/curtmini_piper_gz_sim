<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="curtmini_piper">
  <!-- The physical robot and sensor frames remain owned by the description package. -->
  <xacro:include filename="$(find curtmini_piper_description)/urdf/curtmini_piper.urdf.xacro" />
  <xacro:arg name="use_cameras" default="True" />

  <xacro:macro name="sim_d435i" params="name">
    <!-- Preserve the body link so Gazebo can attach rendering and IMU sensors. -->
    <gazebo reference="${name}_body_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="${name}_body_link">
      <sensor name="${name}_rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/${name}</topic>
        <gz_frame_id>${name}_color_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
      </sensor>
      <sensor name="${name}_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <pose>0 0 0 -1.5707963267948966 0 -1.5707963267948966</pose>
        <topic>/${name}/imu</topic>
        <gz_frame_id>${name}_imu_optical_frame</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="$(arg use_cameras)">
    <xacro:sim_d435i name="base_camera" />
    <xacro:sim_d435i name="tool_camera" />
  </xacro:if>

  <!-- Keep the fixed sensor link in the generated SDF instead of lumping it. -->
  <xacro:if value="$(arg use_hokuyo)">
    <gazebo reference="hokuyo_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="hokuyo_link">
      <sensor name="hokuyo_utm_30lx_ew" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>40</update_rate>
        <visualize>true</visualize>
        <topic>/scan</topic>
        <gz_frame_id>hokuyo_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1081</samples>
              <resolution>1</resolution>
              <min_angle>-2.356194490192345</min_angle>
              <max_angle>2.356194490192345</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
