<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="curtmini_piper">
  <!-- The physical robot and sensor frames remain owned by the description package. -->
  <xacro:include filename="$(find curtmini_piper_description)/urdf/curtmini_piper.urdf.xacro" />

  <!-- Keep the fixed sensor link in the generated SDF instead of lumping it. -->
  <xacro:if value="$(arg use_hokuyo)">
    <gazebo reference="hokuyo_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="hokuyo_link">
      <sensor name="hokuyo_utm_30lx_ew" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>40</update_rate>
        <visualize>true</visualize>
        <topic>/scan</topic>
        <gz_frame_id>hokuyo_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1081</samples>
              <resolution>1</resolution>
              <min_angle>-2.356194490192345</min_angle>
              <max_angle>2.356194490192345</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
